# Copy to .env for local work (.env is not committed).
# Vercel: add the same name in Project Settings > Environment Variables (Production, and Preview if used), then redeploy.
#
# The backend API base URL, including /api/v1, no trailing slash.
# Local Docker backend:
VITE_API_URL=http://localhost:4100/api/v1
# Deployed backend (must be https:// when the dashboard is on https):
# VITE_API_URL=https://your-backend-host.example.com/api/v1
